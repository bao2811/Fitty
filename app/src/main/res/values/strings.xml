    <string name="plan_exercise_bodyweight_squat_desc">A safe lower-body starter move that helps new users learn squat form and balance.</string>
    <string name="plan_exercise_incline_push_up_desc">An easier push-up variation that builds pressing strength without overwhelming beginners.</string>
    <string name="plan_exercise_plank_desc">A full-body hold that teaches posture, bracing, and tension control.</string>
    <string name="plan_exercise_reverse_lunge_desc">A balanced beginner lunge variation that improves leg strength and coordination.</string>
    <string name="plan_exercise_glute_bridge_desc">A simple floor movement that teaches hip extension and glute activation.</string>
    <string name="plan_exercise_bodyweight_squat_step_1">Stand with feet shoulder-width apart and brace your core.</string>
    <string name="plan_exercise_bodyweight_squat_step_2">Push hips back while bending knees.</string>
    <string name="plan_exercise_bodyweight_squat_step_3">Drive through your heels to return to standing.</string>
    <string name="plan_exercise_bodyweight_squat_mistake_1">Knees collapse inward.</string>
    <string name="plan_exercise_bodyweight_squat_mistake_2">Heels lift off the floor.</string>
    <string name="plan_exercise_bodyweight_squat_mistake_3">Chest drops too far forward.</string>
    <string name="plan_exercise_bodyweight_squat_tip_1">Keep your chest lifted.</string>
    <string name="plan_exercise_bodyweight_squat_tip_2">Move slowly on the way down.</string>
    <string name="plan_exercise_bodyweight_squat_tip_3">Use a chair behind you if needed.</string>
    <string name="plan_exercise_incline_push_up_step_1">Place hands on a sturdy elevated surface.</string>
    <string name="plan_exercise_incline_push_up_step_2">Keep a straight line from shoulders to heels.</string>
    <string name="plan_exercise_incline_push_up_step_3">Lower chest with control and press back up.</string>
    <string name="plan_exercise_incline_push_up_mistake_1">Hips sag downward.</string>
    <string name="plan_exercise_incline_push_up_mistake_2">Elbows flare too wide.</string>
    <string name="plan_exercise_incline_push_up_mistake_3">Shoulders shrug up to ears.</string>
    <string name="plan_exercise_incline_push_up_tip_1">Choose a higher surface if needed.</string>
    <string name="plan_exercise_incline_push_up_tip_2">Keep your core tight throughout.</string>
    <string name="plan_exercise_incline_push_up_tip_3">Exhale as you press away.</string>
    <string name="plan_exercise_plank_step_1">Place forearms under shoulders.</string>
    <string name="plan_exercise_plank_step_2">Lift hips so your body forms a straight line.</string>
    <string name="plan_exercise_plank_step_3">Hold while breathing slowly and keeping core engaged.</string>
    <string name="plan_exercise_plank_mistake_1">Hips drop too low.</string>
    <string name="plan_exercise_plank_mistake_2">Hips rise too high.</string>
    <string name="plan_exercise_plank_mistake_3">Breath is held for too long.</string>
    <string name="plan_exercise_plank_tip_1">Squeeze glutes to protect your lower back.</string>
    <string name="plan_exercise_plank_tip_2">Keep your neck neutral.</string>
    <string name="plan_exercise_plank_tip_3">Start with shorter holds if needed.</string>
    <string name="plan_exercise_reverse_lunge_step_1">Stand tall with feet hip-width apart.</string>
    <string name="plan_exercise_reverse_lunge_step_2">Step one foot backward and lower both knees.</string>
    <string name="plan_exercise_reverse_lunge_step_3">Push through the front foot to return to standing.</string>
    <string name="plan_exercise_reverse_lunge_mistake_1">Leaning too far forward.</string>
    <string name="plan_exercise_reverse_lunge_mistake_2">Front knee turns inward.</string>
    <string name="plan_exercise_reverse_lunge_mistake_3">Stride is too narrow.</string>
    <string name="plan_exercise_reverse_lunge_tip_1">Take a long enough step back.</string>
    <string name="plan_exercise_reverse_lunge_tip_2">Move under control.</string>
    <string name="plan_exercise_reverse_lunge_tip_3">Use a wall lightly for support if needed.</string>
    <string name="plan_exercise_glute_bridge_step_1">Lie on your back with knees bent and feet flat.</string>
    <string name="plan_exercise_glute_bridge_step_2">Press through the heels and lift hips up.</string>
    <string name="plan_exercise_glute_bridge_step_3">Pause briefly at the top, then lower slowly.</string>
    <string name="plan_exercise_glute_bridge_mistake_1">Lower back arches too much.</string>
    <string name="plan_exercise_glute_bridge_mistake_2">Toes do most of the pushing.</string>
    <string name="plan_exercise_glute_bridge_mistake_3">Knees drift inward or outward.</string>
    <string name="plan_exercise_glute_bridge_tip_1">Squeeze your glutes at the top.</string>
    <string name="plan_exercise_glute_bridge_tip_2">Keep ribs down.</string>
    <string name="plan_exercise_glute_bridge_tip_3">Slow reps help beginners feel the right muscles.</string>
